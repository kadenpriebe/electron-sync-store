{
  "name": "electron-sync-store",
  "version": "0.1.0",
  "description": "Synchronous global state across Electron's main and renderer processes.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:preload && npm run build:renderer && cp example/*.html dist/example/",
    "build:preload": "esbuild example/preload.ts example/inspector-preload.ts --bundle --outdir=dist/example --format=cjs --platform=node --external:electron",
    "build:renderer": "esbuild example/renderer.ts example/inspector.ts --bundle --outdir=dist/example --format=iife --platform=browser",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron dist/example/main.js",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "state-management",
    "ipc",
    "typescript"
  ],
  "author": "kadenpriebe",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
