{
  "name": "electron-sync-store",
  "version": "0.1.0",
  "description": "Synchronous global state across Electron's main and renderer processes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:lib && npm run build:example",
    "build:lib": "tsc -p tsconfig.lib.json",
    "build:example": "npm run build:example:node && npm run build:example:web && cp example/*.html dist/example/",
    "build:example:node": "esbuild example/main.ts example/preload.ts example/inspector-preload.ts --bundle --outdir=dist/example --format=cjs --platform=node --external:electron",
    "build:example:web": "esbuild example/renderer.ts example/renderer-react.tsx example/inspector.ts --bundle --outdir=dist/example --format=iife --platform=browser --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\"",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron dist/example/main.js",
    "test": "vitest run",
    "verify": "npm run build && electron scripts/verify-demo.js"
  },
  "keywords": [
    "electron",
    "state-management",
    "ipc",
    "typescript"
  ],
  "author": "kadenpriebe",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/example"
  ],
  "sideEffects": [
    "./dist/preload/index.js"
  ],
  "peerDependencies": {
    "electron": ">=28",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
